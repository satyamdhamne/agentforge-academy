# Copy to .env and adjust. Every variable has a safe development default; production refuses unsafe values.

# --- Runtime -------------------------------------------------------------------
ENV=development                 # development | test | production
LOG_LEVEL=INFO

# --- Database (docker compose builds DATABASE_URL from these) -------------------
POSTGRES_USER=agentforge
POSTGRES_PASSWORD=agentforge
POSTGRES_DB=agentforge
# For running the API outside Docker:
# DATABASE_URL=postgresql+psycopg://agentforge:agentforge@localhost:5432/agentforge

# --- Web / sessions -------------------------------------------------------------
FRONTEND_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
COOKIE_SECURE=false             # must be true in production (HTTPS)
# COOKIE_DOMAIN=
SESSION_TTL_HOURS=336
TRUSTED_PROXIES=0               # number of reverse proxies in front of the API (for client IPs)

# --- Email (console prints links to the API log; production requires smtp) -----
MAIL_BACKEND=console
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=AgentForge Academy <no-reply@your-domain>

# --- Sandboxed code execution ---------------------------------------------------
# Leave SANDBOX_URL empty to disable execution: code is then shown read-only and submissions are not graded.
SANDBOX_URL=http://sandbox:8080
SANDBOX_TOKEN=dev-sandbox-token-change-me   # shared secret between API and runner; generate a long random value

# --- Model providers (server-side only; never exposed to the browser) ----------
LLM_PROVIDER=mock               # mock | openai | anthropic   (mock needs no key)
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_BASE_URL=https://api.openai.com/v1     # any OpenAI-compatible endpoint, e.g. Ollama: http://host.docker.internal:11434/v1
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# Per-model prices for cost estimates (USD per million tokens), JSON:
# MODEL_PRICES={"your-model": {"input_per_mtok": 0.25, "output_per_mtok": 1.25}}
AGENT_RUN_TIMEOUT_S=60

# --- Rate limits (requests per minute) ------------------------------------------
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_SANDBOX_PER_MINUTE=30
RATE_LIMIT_AGENT_RUNS_PER_MINUTE=10

# --- Seed data ------------------------------------------------------------------
SEED_ON_START=1                 # load curriculum, challenges, agents and demo accounts at startup (idempotent)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe-Admin-123!       # production refuses passwords containing "ChangeMe"
SEED_DEMO_EMAIL=learner@example.com
SEED_DEMO_PASSWORD=ChangeMe-Learner-123!
